[Unit]
Description=MLOps CD Validation Server
After=network.target

[Service]
Type=simple
User=root
Group=root

ExecStartPre=/usr/bin/install -d -o root -g root -m 700 /run/mlops-cd/locks
ExecStart=/usr/bin/python3 -B /usr/local/libexec/mlops-cd/socket_server.py

RuntimeDirectory=mlops-cd
RuntimeDirectoryMode=0755

Restart=on-failure
RestartSec=5

UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/mlops-cd

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
