    {
      "id": 7,
      "title": "ML Metrics Calculation Age (seconds)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "time() - ml_metrics_last_calculation_timestamp_seconds{job=\"ml-monitoring-historical\",data_source=\"historical\",environment=\"evaluation\"}",
          "legendFormat": "{{dataset}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
